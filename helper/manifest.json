{
  "manifest_version": 3,
  "name": "LIVV 酒店助手",
  "version": "1.0.0",
  "description": "领取云端任务并自动采集携程移动端真实酒店市场数据",
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": ["https://api.livv.cc/*", "https://m.ctrip.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://m.ctrip.com/webapp/hotels/*"],
      "js": ["ready.js"],
      "run_at": "document_idle"
    }
  ]
}

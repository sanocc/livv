{
  "manifest_version": 3,
  "name": "酒店助手",
  "version": "0.4.0",
  "description": "酒店助手自动化获取主流OTA平台最新房价信息，目前已接入携程、美团、飞猪、同程艺龙，可本地采集使用，授权后可同步云端。https://ota.livv.cc",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://api.livv.cc/*",
    "https://livv-api.sanxxcc.workers.dev/*",
    "https://*.ctrip.com/*",
    "https://*.trip.com/*",
    "https://*.meituan.com/*",
    "https://*.dianping.com/*",
    "https://*.fliggy.com/*",
    "https://*.taobao.com/*",
    "https://*.alitrip.com/*",
    "https://*.ly.com/*",
    "https://*.tongcheng.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "酒店助手",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "core/runtime.js",
        "core/engine.js",
        "core/quality.js",
        "core/types.js",
        "debug/logger.js",
        "adapters/base.js",
        "adapters/ctrip.js",
        "adapters/meituan.js",
        "adapters/fliggy.js",
        "adapters/tongcheng.js"
      ],
      "matches": [
        "https://hotels.ctrip.com/*",
        "https://hotel.meituan.com/*",
        "https://ihotel.meituan.com/*",
        "https://i.meituan.com/*",
        "https://hotel.dianping.com/*",
        "https://*.fliggy.com/*",
        "https://*.alitrip.com/*",
        "https://*.taobao.com/*",
        "https://*.ly.com/*",
        "https://*.tongcheng.com/*"
      ]
    }
  ]
}

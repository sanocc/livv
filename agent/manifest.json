{
  "manifest_version": 3,
  "name": "POAI 酒店助手",
  "version": "1.3.4",
  "description": "POAI 本地数据采集与任务执行端；当前支持携程移动端酒店市场采集",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "debugger",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.poai.cc/*",
    "https://m.ctrip.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 POAI Agent",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://m.ctrip.com/webapp/hotels/*"
      ],
      "js": [
        "ready.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}

{
  "name": "poai-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "api.poai.cc",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "poai-data",
      "database_id": "75a2bb2d-ca57-4be9-9eb4-6b389d504c5f",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "ENVIRONMENT": "production",
    "CF_ACCOUNT_ID": "de623dd659f63579a4656ab3a8ada602"
  },
  "ratelimits": [
    {
      "name": "REGISTRATION_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "HELPER_EVENTS",
      "dataset": "agent_events"
    }
  ]
}

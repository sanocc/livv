{
  "name": "livv-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "api.poai.cc",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "livv-v1",
      "database_id": "68cfcb1e-913a-4013-aa9d-5ae27f2a1150",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "ENVIRONMENT": "production",
    "CF_ACCOUNT_ID": "de623dd659f63579a4656ab3a8ada602"
  },
  "ratelimits": [
    {
      "name": "REGISTRATION_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "HELPER_EVENTS",
      "dataset": "livv_helper_events"
    }
  ]
}

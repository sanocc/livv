{
  "name": "livv-ota",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "routes": [{ "pattern": "ota.livv.cc", "custom_domain": true }],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [{ "binding": "API", "service": "livv-api" }],
  "vars": { "ENVIRONMENT": "production" },
  "observability": { "enabled": true }
}
